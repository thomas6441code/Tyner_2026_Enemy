APP_NAME="Employee Attendance & Permission Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eapms
DB_USERNAME=eapms
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@ifm.ac.tz"
MAIL_FROM_NAME="${APP_NAME}"

# Internal service secrets
INTERNAL_API_SECRET=change-me-in-production
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT=30
BIO_SERVICE_URL=http://localhost:8002
BIO_SERVICE_TIMEOUT=10

# Account activation — minutes an invitation link stays redeemable (4320 = 72 hours).
# Public self-registration is closed: /register submits a request that Admin/HR approve,
# which mints a single-use activation link.
AUTH_INVITATION_EXPIRE=4320

# WebAuthn (mobile check-in passkeys)
# WEBAUTHN_RP_ID MUST be the public registrable domain the browser sees — no scheme, no port,
# no container hostname. Leave empty to fall back to the host of APP_URL (correct locally).
# navigator.credentials only exists on HTTPS or localhost, so mobile check-in cannot work
# over plain http:// on a LAN IP.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME="${APP_NAME}"
WEBAUTHN_TIMEOUT_MS=60000
# Hard block: no valid assertion, no check-in. Set false only to exercise the surrounding
# flow locally without a platform authenticator.
WEBAUTHN_REQUIRE=true

# Mobile check-in channel tunables
MOBILE_MAX_ACCURACY_METERS=100
MOBILE_MIN_INTERVAL_SECONDS=60
MOBILE_CHECK_IN_EARLY_MINUTES=120
MOBILE_CHECK_IN_LATE_MINUTES=240
MOBILE_CHECK_OUT_EARLY_MINUTES=120
MOBILE_CHECK_OUT_LATE_MINUTES=240
MOBILE_IMPOSSIBLE_TRAVEL_KMH=200

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
