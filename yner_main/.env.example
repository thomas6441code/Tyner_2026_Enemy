APP_NAME="Employee Attendance & Permission Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# The clock every punch is stamped with. Mobile check-ins take `punched_at` from the SERVER,
# never from the phone, so this value alone decides whether an arrival counts as on time and
# whether it falls inside the schedule window. It must match the timezone the work_schedules
# start/end times are written in.
APP_TIMEZONE=Africa/Dar_es_Salaam

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eapms
DB_USERNAME=eapms
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# `log` writes mail to storage/logs/laravel.log instead of sending. Switch to `smtp`
# for real delivery. Laravel 12 reads MAIL_SCHEME, not the old MAIL_ENCRYPTION:
# use MAIL_SCHEME=smtp for STARTTLS on port 587, or smtps for implicit TLS on 465.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# MAIL_FROM_ADDRESS is required. Most providers (Gmail in particular) reject a From
# address that is not the authenticated MAIL_USERNAME, so keep the two in sync.
MAIL_FROM_ADDRESS="noreply@ifm.ac.tz"
MAIL_FROM_NAME="${APP_NAME}"

# Gmail example (requires a Google account App Password, not the login password):
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-16-char-app-password
# MAIL_FROM_ADDRESS=you@gmail.com

# Internal service secrets
INTERNAL_API_SECRET=change-me-in-production
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT=30
BIO_SERVICE_URL=http://localhost:8002
BIO_SERVICE_TIMEOUT=10

# Account activation — minutes an invitation link stays redeemable (4320 = 72 hours).
# Public self-registration is closed: /register submits a request that Admin/HR approve,
# which mints a single-use activation link.
AUTH_INVITATION_EXPIRE=4320

# Reject registration requests whose email domain has no mail server (MX/A lookup).
# Set to false only where outbound DNS is unavailable — the check would then fail every address.
AUTH_VERIFY_EMAIL_DOMAIN=true

# WebAuthn (mobile check-in passkeys)
# WEBAUTHN_RP_ID MUST be the public registrable domain the browser sees — no scheme, no port,
# no container hostname. Leave empty to fall back to the host of APP_URL (correct locally).
# navigator.credentials only exists on HTTPS or localhost, so mobile check-in cannot work
# over plain http:// on a LAN IP.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME="${APP_NAME}"
WEBAUTHN_TIMEOUT_MS=60000
# Registration sends every active credential in the system as excludeCredentials, so a phone
# already linked to an account cannot enrol for a second one. Raise this above your expected
# number of active devices; a warning is logged whenever it truncates.
WEBAUTHN_EXCLUDE_LIMIT=500

# One account is linked to one and only one device. The binding token below is the half of
# that rule WebAuthn cannot enforce: it identifies the handset, not the credential.
DEVICE_TOKEN_COOKIE=eapms_device
DEVICE_TOKEN_TTL_DAYS=730
# How long an approved device reset stays usable. Employees cannot unlink their own phone;
# an Admin or HR Officer approves, which revokes the old device and opens this window.
DEVICE_RESET_WINDOW_HOURS=24

# Employee codes are allocated by the server, never typed. The sequence is derived from the
# highest code carrying this prefix, so changing the prefix starts a fresh sequence rather than
# renumbering anyone. Widen the padding before you approach its limit, not after.
EMPLOYEE_CODE_PREFIX=EMP-
EMPLOYEE_CODE_PADDING=4

# Mobile check-in channel tunables
MOBILE_MAX_ACCURACY_METERS=100
MOBILE_MIN_INTERVAL_SECONDS=60
MOBILE_CHECK_IN_EARLY_MINUTES=120
MOBILE_CHECK_IN_LATE_MINUTES=240
MOBILE_CHECK_OUT_EARLY_MINUTES=120
MOBILE_CHECK_OUT_LATE_MINUTES=240
MOBILE_IMPOSSIBLE_TRAVEL_KMH=200

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
